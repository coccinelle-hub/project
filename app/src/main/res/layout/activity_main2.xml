<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_verdict_nj"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity2">

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        app:srcCompat="@drawable/capture_d__cran_2026_11_08_192603" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:gravity="clip_horizontal"
        android:text="Scanner de Paradoxe"
        android:textColor="#673AB7"
        android:textSize="22sp"
        android:textStyle="bold" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textView4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#2A1B60"
                android:gravity="center"
                android:padding="8dp"
                android:text="Passeport Temporel"
                android:textColor="#3E1C7A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageView3"
                    android:layout_width="169dp"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/capture_d__cran_2026_11_09_033916" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    tools:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/text_nom_nj"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Nom : "
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_age_nj"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Âge temporel : " />

                    <TextView
                        android:id="@+id/text_motif_nj"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Motif : " />

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btn_approuver_nj"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#1E8E3E"
        android:text="Approuver le saut temporel"
        android:textColor="#FFFFFF"
        app:cornerRadius="24dp" />

    <Button
        android:id="@+id/btn_refuser_nj"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:backgroundTint="#D93025"
        android:text="Refuser (Risque de paradoxe)"
        app:cornerRadius="24dp"
        tools:textColor="#FFFFFF" />

</LinearLayout>